{
  "name": "smolcoder",
  "version": "0.7.1-mtplx.1",
  "private": true,
  "description": "A Qwen 3.8 coding agent served by MTPLX with a local-first software harness.",
  "keywords": [
    "cli",
    "coding-agent",
    "agent",
    "ollama",
    "lm-studio",
    "local-llm",
    "local-models",
    "smol",
    "ai"
  ],
  "license": "MIT",
  "author": "Leon van Zyl",
  "homepage": "https://github.com/Alexmacapple/smolcoder-MTPLX#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alexmacapple/smolcoder-MTPLX.git"
  },
  "bugs": {
    "url": "https://github.com/Alexmacapple/smolcoder-MTPLX/issues"
  },
  "bin": {
    "smol": "dist/index.js",
    "smolcoder": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc && node -e \"require('fs').chmodSync('dist/index.js', 0o755)\"",
    "dev": "tsc -w",
    "prepublishOnly": "npm test",
    "test": "npm run build && node scripts/test.cjs",
    "test:os": "npm run build && node scripts/test-os.cjs"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
